PORT=4000
JWT_SECRET=change-me-in-production

# DB_DRIVER=json (default) uses the local data/db.json file, no Oracle needed.
# DB_DRIVER=oracle talks to a local Oracle DB through ORDS AutoREST — see
# backend/oracle/provision_mahaldb.sql for one-time setup (proper
# cities/categories lookup tables + FK integrity — the original flat
# schema is backend/oracle/provision.sql, kept but no longer used), and
# start ORDS first: java -jar ords.war --config <config-dir> serve
DB_DRIVER=json
ORDS_BASE_URL=http://localhost:8080/ords/mahaldb
